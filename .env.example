# ═══════════════════════════════════════════════════════════════
# VORTEX — Environment Configuration (example)
# Copy to backend/.env (scripts/setup.sh does this automatically
# and generates strong random secrets). NEVER commit real values.
# ═══════════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# ── Database (PostgreSQL) ──────────────────────────────────────
DATABASE_URL=postgresql://vortex:vortex_dev@localhost:5433/vortex?schema=public

# ── Auth secrets (leave empty — setup.sh generates them) ───────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
MEDIA_SIGNING_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# ── Uploads / Storage ──────────────────────────────────────────
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8
ALLOWED_MIME=image/jpeg,image/png,image/webp

# ── AI Provider ────────────────────────────────────────────────
# auto  → use gemini/openai if a key exists, otherwise mock (dev fallback)
# mock  → force the clearly-labelled development mock provider
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=45000
EXPERT_REVIEW_THRESHOLD=0.75

# ── Seeding (development only) ─────────────────────────────────
SEED_DEMO=true
